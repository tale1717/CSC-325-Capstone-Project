<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.firebaseadminjavafx.WorkoutPlanningController"
      spacing="15" alignment="CENTER" prefWidth="450" prefHeight="500"
      style="-fx-background-color: #1B5E20;">

    <children>
        <!-- Title - Christmas White -->
        <Label text="Workout Planning" style="-fx-text-fill: #FFFAFA; -fx-font-weight: bold;">
            <font>
                <Font size="20.0" />
            </font>
        </Label>

        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" />
                <ColumnConstraints halignment="LEFT" />
            </columnConstraints>
            <children>
                <!-- All Labels - Christmas White -->
                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-text-fill: #FFFAFA; -fx-font-weight: bold;"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                           prefWidth="220" prefHeight="30"
                           style="-fx-background-color: white; -fx-border-color: #FFD700; -fx-border-radius: 3; -fx-background-radius: 3;"/>

                <Label text="Height (inches):" GridPane.rowIndex="1" GridPane.columnIndex="0"
                       style="-fx-text-fill: #FFFAFA; -fx-font-weight: bold;"/>
                <TextField fx:id="heightField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                           prefHeight="30"
                           style="-fx-background-color: white; -fx-border-color: #FFD700; -fx-border-radius: 3; -fx-background-radius: 3;"/>

                <Label text="Weight (pounds):" GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-text-fill: #FFFAFA; -fx-font-weight: bold;"/>
                <TextField fx:id="weightField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                           prefHeight="30"
                           style="-fx-background-color: white; -fx-border-color: #FFD700; -fx-border-radius: 3; -fx-background-radius: 3;"/>

                <Label text="Age:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                       style="-fx-text-fill: #FFFAFA; -fx-font-weight: bold;"/>
                <TextField fx:id="ageField" GridPane.rowIndex="3" GridPane.columnIndex="1"
                           prefHeight="30"
                           style="-fx-background-color: white; -fx-border-color: #FFD700; -fx-border-radius: 3; -fx-background-radius: 3;"/>

                <Label text="Goal:" GridPane.rowIndex="4" GridPane.columnIndex="0"
                       style="-fx-text-fill: #FFFAFA; -fx-font-weight: bold;"/>
                <ComboBox fx:id="goalBox" GridPane.rowIndex="4" GridPane.columnIndex="1"
                          prefWidth="220" prefHeight="30"
                          style="-fx-background-color: white; -fx-border-color: #FFD700; -fx-border-radius: 3; -fx-background-radius: 3;"/>
            </children>
        </GridPane>

        <!-- Generate & Save Plan Button - Christmas Red -->
        <Button fx:id="generateButton"
                text="Generate &amp; Save Plan"
                onAction="#handleGenerateAndSave"
                prefWidth="220" prefHeight="40"
                style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-background-radius: 5;"/>

        <!-- Result TextArea -->
        <TextArea fx:id="resultArea"
                  prefWidth="380" prefHeight="200"
                  wrapText="true"
                  style="-fx-background-color: white; -fx-border-color: #FFD700; -fx-border-radius: 3; -fx-background-radius: 3; -fx-font-size: 13px;"/>

        <!-- Back Button - Christmas Red -->
        <Button fx:id="backButton"
                text="Back"
                onAction="#handleBack"
                prefWidth="120" prefHeight="35"
                style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-background-radius: 5;"/>
    </children>

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>
</VBox>