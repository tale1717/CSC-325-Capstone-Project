<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="mainContainer"
      alignment="TOP_CENTER"
      spacing="20"
      prefWidth="400.0"
      prefHeight="400.0"
      stylesheets="@welcome.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.firebaseadminjavafx.WelcomeController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <!-- Title -->
    <Label fx:id="titleLabel" text="Gym Prototype">
        <font>
            <Font size="24.0"/>
        </font>
    </Label>

    <!-- Subtitle -->
    <Label fx:id="subtitleLabel" text="Create an account">
        <font>
            <Font size="18.0"/>
        </font>
    </Label>

    <!-- Instruction -->
    <Label text="Enter your email to sign up for this Gym Prototype"
           wrapText="true"/>

    <!-- Email Field (wired to WelcomeController.emailID) -->
    <TextField fx:id="emailID"
               promptText="email@domain.com"
               prefWidth="300.0"
               prefHeight="40.0">
        <font>
            <Font size="14.0"/>
        </font>
    </TextField>

    <!-- Password Field (wired to WelcomeController.passwordID) -->
    <PasswordField fx:id="passwordID"
                   promptText="Enter your password"
                   prefWidth="300.0"
                   prefHeight="40.0">
        <font>
            <Font size="14.0"/>
        </font>
    </PasswordField>

    <!-- Error label (wired to WelcomeController.errorLabel) -->
    <Label fx:id="errorLabel"
           wrapText="true"
           textFill="#c62828"
           style="-fx-font-size: 13px; -fx-font-weight: bold;"
           maxWidth="300.0"/>

    <!-- Register and Sign In Buttons -->
    <Button fx:id="registerButton"
            text="Register"
            onAction="#registerButtonClicked"
            prefWidth="300.0"
            prefHeight="40.0">
        <font>
            <Font size="14.0"/>
        </font>
    </Button>

    <Button fx:id="signInButton"
            text="Sign In"
            onAction="#signInButtonClicked"
            defaultButton="true"
            prefWidth="300.0"
            prefHeight="40.0">
        <font>
            <Font size="14.0"/>
        </font>
    </Button>

    <!-- OR separator -->
    <Label fx:id="orLabel" text="or continue with"/>

    <!-- Google Button (visual only for now) -->
    <Button fx:id="googleButton"
            text="Google"
            prefWidth="300.0"
            prefHeight="40.0">
        <font>
            <Font size="14.0"/>
        </font>
    </Button>

    <!-- Terms and Privacy -->
    <Label fx:id="termsLabel"
           text="By clicking continue, you agree to our Terms of Service and Privacy Policy"
           wrapText="true"
           textAlignment="CENTER"
           prefWidth="300.0">
        <font>
            <Font size="12.0"/>
        </font>
    </Label>

</VBox>