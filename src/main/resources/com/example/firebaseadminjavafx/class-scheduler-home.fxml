<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="900.0" prefWidth="1400.0"
            style="-fx-background-color: #1B5E20;"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.firebaseadminjavafx.controllers.ClassSchedulerController">

    <children>

        <ImageView fitHeight="900.0" fitWidth="1400.0" preserveRatio="false">
            <image>
                <Image url="@gymbgimageTwo.png" />
            </image>
        </ImageView>

        <ImageView fitHeight="300.0" fitWidth="300.0" layoutX="200.0" layoutY="100.0" preserveRatio="false">
            <image>
                <Image url="@snowicon.png" />
            </image>
        </ImageView>

        <ImageView fitHeight="300.0" fitWidth="300.0" layoutX="900.0" layoutY="100.0" preserveRatio="false">
            <image>
                <Image url="@snowicon.png" />
            </image>
        </ImageView>

        <Label layoutX="537.0" layoutY="95.0"
               style="-fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(255,255,255,0.8), 3, 0, 0, 1);"
               text="Schedule A Class!">
            <font>
                <Font size="48.0" />
            </font>
        </Label>

        <Button fx:id="openClassSchdbtn"
                layoutX="600.0" layoutY="320.0"
                onAction="#handleOpenClass"
                prefHeight="60.0" prefWidth="220.0"
                style="-fx-background-color: #1B5E20; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 3, 0, 0, 2);"
                text="Classes">
            <font>
                <Font size="18.0" />
            </font>
        </Button>

        <Button fx:id="adminButton"
                layoutX="600.0" layoutY="440.0"
                onAction="#handleAdminButton"
                prefHeight="60.0" prefWidth="220.0"
                style="-fx-background-color: #1B5E20; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 3, 0, 0, 2);"
                text="Admin">
            <font>
                <Font size="18.0" />
            </font>
        </Button>

        <Button fx:id="backButton"
                layoutX="600.0" layoutY="560.0"
                onAction="#handleBackToMain"
                prefHeight="60.0" prefWidth="220.0"
                style="-fx-background-color: #1B5E20; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 3, 0, 0, 2);"
                text="Back">
            <font>
                <Font size="18.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
