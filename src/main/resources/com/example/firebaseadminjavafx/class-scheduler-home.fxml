<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="400.0" spacing="20.0" xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.firebaseadminjavafx.controllers.ClassSchedulerController"
      style="-fx-background-color: #1B5E20;"> <!-- Christmas green background -->

    <children>
        <!-- Title with Christmas gold -->
        <Label text="Schedule A Class!" style="-fx-text-fill: #FFD700; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 3, 0, 0, 1);">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <!-- Classes Button - Christmas red -->
        <Button fx:id="openClassSchdbtn" onAction="#handleOpenClass" prefWidth="200" prefHeight="50"
                style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 3, 0, 0, 2);"
                text="Classes" />

        <!-- Admin Button - Christmas red -->
        <Button fx:id="adminButton" onAction="#handleAdminButton" prefWidth="200" prefHeight="50"
                style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 3, 0, 0, 2);"
                text="Admin" />

        <!-- Back Button - Christmas red -->
        <Button fx:id="backButton" onAction="#handleBackToMain" prefWidth="120" prefHeight="40"
                style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 3, 0, 0, 2);"
                text="Back" />
    </children>

    <padding>
        <Insets top="40" right="20" bottom="40" left="20" />
    </padding>
</VBox>
