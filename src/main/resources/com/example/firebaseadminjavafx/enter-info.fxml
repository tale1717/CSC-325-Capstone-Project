<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="TOP_CENTER" prefHeight="600" prefWidth="800" spacing="0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.firebaseadminjavafx.EnterInfoController">

    <children>

        <!-- Green Header Bar - Extended to cover everything above the white area -->
        <VBox spacing="0" style="-fx-background-color: #1B5E20;">
            <!-- Top section with Gym Prototype and navigation -->
            <HBox style="-fx-padding: 15;">
                <!-- Gym Prototype Title (Left) -->
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" text="Jolly Gym'nas" />
                  <Button onAction="#handleHome" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand; -fx-padding: 0;" text="                                                    Home  " />

                <!-- Spacer to push buttons to the right -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Navigation Buttons (Right, white text) - Home is now clickable -->
                <HBox alignment="CENTER_RIGHT" spacing="30">
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-text-fill: white;" />
                        <Label style="-fx-font-size: 16px; -fx-text-fill: white;" />
                        <Label style="-fx-font-size: 16px; -fx-text-fill: white;" />
                        <Label style="-fx-font-size: 16px; -fx-text-fill: white;" />
                    </children>
                </HBox>
            </HBox>

            <!-- Extended green area to cover where the separator would be -->
            <Region style="-fx-background-color: #1B5E20; -fx-min-height: 50;" />
        </VBox>

        <!-- White content area starts here with Profile title -->
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30 0 20 0;">

            <!-- Page Title -->
            <Label style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: black;" text="Profile" />

            <!-- Profile Picture -->
            <StackPane alignment="CENTER">
                <children>
                    <Circle fill="#e0e0e0" radius="70" stroke="#c0c0c0" strokeWidth="2" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: black;" text="Profile Pic here" />
                </children>
            </StackPane>

            <!-- Display Name -->
            <Label fx:id="nameField" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: black;" text="Your name here" />

            <!-- Display Email -->
            <Label fx:id="emailField" style="-fx-font-size: 16px; -fx-text-fill: black;" text="Your email here" />

            <!-- Stats Section -->
            <HBox alignment="CENTER" spacing="120">
                <children>
                    <VBox alignment="CENTER" spacing="10">
                        <children>
                            <Label style="-fx-font-size: 40px; -fx-text-fill: #FF0000;" text="⏰" />
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: black;" text="Total time spent" />
                        </children>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10">
                        <children>
                            <Label style="-fx-font-size: 40px; -fx-text-fill: #FF5722;" text="🔥" />
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: black;" text="Calories burned" />
                        </children>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10">
                        <children>
                            <Label style="-fx-font-size: 40px; -fx-text-fill: #FFEB3B;" text="💪" />
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: black;" text="Exercises done" />
                        </children>
                    </VBox>
                </children>
            </HBox>

        </VBox>

    </children>

</VBox>
