<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.firebaseadminjavafx.ClassScheduler">

   <children>
      <Label alignment="CENTER" layoutX="122.0" layoutY="36.0" prefHeight="20.0" prefWidth="158.0" text="View All Classes Below">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>

      <Button layoutX="23.0" layoutY="96.0" mnemonicParsing="false" onAction="#handleSuggestClass" text="Suggested Classes" />
      
      <Label alignment="CENTER" layoutX="153.0" layoutY="100.0" prefHeight="17.0" prefWidth="100.0" text="Available Classes" />
      <Button fx:id="searchClassButton" layoutX="293.0" layoutY="133.0" mnemonicParsing="false" onAction="#handleSearchClass" text="Search" />
      <Button fx:id="backButton" layoutX="178.0" layoutY="321.0" mnemonicParsing="false" onAction="#handleBackToMain" text="Back" />
      <TextField fx:id="searchField" layoutX="266.0" layoutY="96.0" prefHeight="26.0" prefWidth="109.0" promptText="Enter Class Name..." />
      <ListView fx:id="classListView" layoutX="128.0" layoutY="133.0" prefHeight="170.0" prefWidth="148.0" />
   </children>
</AnchorPane>
