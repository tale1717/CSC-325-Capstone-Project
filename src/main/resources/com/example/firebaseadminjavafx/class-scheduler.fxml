<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.firebaseadminjavafx.controllers.ClassScheduler">

    <children>
        <Label layoutX="20.0" layoutY="20.0"
               text="Class Scheduler">
            <font>
                <Font name="System Bold" size="20.0"/>
            </font>
        </Label>

        <!-- Class list -->
        <ListView fx:id="classListView"
                  layoutX="20.0" layoutY="60.0"
                  prefWidth="560.0" prefHeight="260.0"/>

        <!-- Bottom buttons (similar layout, old feel + new actions) -->
        <Button layoutX="20.0" layoutY="340.0"
                prefWidth="120.0" prefHeight="30.0"
                text="View Details"
                onAction="#handleOpenClass"/>

        <Button layoutX="160.0" layoutY="340.0"
                prefWidth="140.0" prefHeight="30.0"
                text="Suggested Classes"
                onAction="#handleSuggestClasses"/>

        <Button layoutX="320.0" layoutY="340.0"
                prefWidth="100.0" prefHeight="30.0"
                text="Admin"
                onAction="#handleAdminButton"/>

        <Button layoutX="440.0" layoutY="340.0"
                prefWidth="100.0" prefHeight="30.0"
                text="Back"
                onAction="#handleBackToMain"/>
    </children>
</AnchorPane>
