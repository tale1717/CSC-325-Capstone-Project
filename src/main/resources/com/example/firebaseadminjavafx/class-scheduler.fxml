<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="400.0"
            style="-fx-background-color: #1B5E20;"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.firebaseadminjavafx.controllers.ClassScheduler">

    <children>

        <Label alignment="CENTER" layoutX="50.0" layoutY="30.0"
               prefHeight="30.0" prefWidth="300.0"
               text="View All Classes Below"
               style="-fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(255,255,255,0.8), 2, 0, 0, 1);">
            <font>
                <Font name="System Bold" size="16.0"/>
            </font>
        </Label>

        <Button fx:id="suggestClassButton"
                layoutX="15.0" layoutY="90.0"
                prefWidth="140" prefHeight="35"
                text="Suggested Classes"
                onAction="#handleSuggestClasses"
                style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-background-radius: 5;"/>

        <TextField fx:id="searchField"
                   layoutX="180.0" layoutY="90.0"
                   prefHeight="35" prefWidth="160"
                   promptText="Enter Class Name..."
                   style="-fx-background-radius: 5;" />

        <Button fx:id="searchClassButton"
                layoutX="345.0" layoutY="90.0"
                prefWidth="40" prefHeight="35"
                text="Go"
                onAction="#handleSearchClass"
                style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-background-radius: 5;"/>

        <ListView fx:id="classListView"
                  layoutX="125.0" layoutY="140.0"
                  prefHeight="160.0" prefWidth="150.0" />

        <Button fx:id="backButton"
                layoutX="40.0" layoutY="320.0"
                prefWidth="120" prefHeight="35"
                text="Back"
                onAction="#handleBackToMain"
                style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-background-radius: 5;"/>

        <!--<Button fx:id="adminButton"
                layoutX="220.0" layoutY="320.0"
                prefWidth="140" prefHeight="35"
                text="Admin"
                onAction="#handleAdminButton"
                style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-background-radius: 5;"/>
    `   -->
    </children>
</AnchorPane>
