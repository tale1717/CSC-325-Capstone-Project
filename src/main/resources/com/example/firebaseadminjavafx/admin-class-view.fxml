<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.firebaseadminjavafx.AdminClassController">
   <children>
      <Label layoutX="30.0" layoutY="30.0" text="Admin: Click Each Option for Handling A Class">
         <font>
            <Font name="System Bold" size="18.0" />
         </font></Label>
      <Button layoutX="158.0" layoutY="115.0" mnemonicParsing="false" text="Add A Class" />
      <Button layoutX="159.0" layoutY="174.0" mnemonicParsing="false" text="Edit A Class" />
      <Button layoutX="153.0" layoutY="236.0" mnemonicParsing="false" text="Remove Class" />
      <Button fx:id="backButton"
              layoutX="178.0"
              layoutY="304.0"
              mnemonicParsing="false"
              onAction="#handleBackToMain"
              text="Back" />
   </children>
</AnchorPane>
