<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.firebaseadminjavafx.AdminClassController">

   <children>
      <Label layoutX="30.0" layoutY="10.0"
             text="Admin: Manage Gym Classes">
         <font>
            <Font name="System Bold" size="18.0"/>
         </font>
      </Label>

      <TableView fx:id="classTable" layoutX="30.0" layoutY="50.0"
                 prefWidth="340.0" prefHeight="250.0">
         <columns>
            <TableColumn fx:id="titleColumn" text="Class Name"/>
            <TableColumn fx:id="instructorColumn" text="Instructor"/>
            <TableColumn fx:id="timeColumn" text="Time"/>
            <TableColumn fx:id="capacityColumn" text="Capacity"/>
         </columns>
      </TableView>

      <Button fx:id="addButton" layoutX="30.0" layoutY="320.0"
              text="Add Class" onAction="#handleAddClass"/>
      <Button fx:id="editButton" layoutX="140.0" layoutY="320.0"
              text="Edit Class" onAction="#handleEditClass"/>
      <Button fx:id="deleteButton" layoutX="265.0" layoutY="320.0"
              text="Delete Class" onAction="#handleDeleteClass"/>
      <Button fx:id="backButton" layoutX="30.0" layoutY="360.0"
              text="Back" onAction="#handleBackToMain"/>
   </children>
</AnchorPane>
