<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.firebaseadminjavafx.GymAppHomeController"
      alignment="TOP_CENTER" spacing="30.0"
      prefWidth="600.0" prefHeight="700.0"
      style="-fx-background-color: white; -fx-padding: 40;">

    <children>
        <!-- Title -->
        <Label text="Gym Prototype" style="-fx-font-weight: bold;">
            <font>
                <Font size="32.0" />
            </font>
        </Label>

        <!-- Main Content Grid -->
        <VBox alignment="CENTER" spacing="20">
            <!-- First Row of Buttons -->
            <HBox alignment="CENTER" spacing="30">
                <Button fx:id="profileButton"
                        text="Profile"
                        onAction="#handleProfile"
                        prefWidth="200" prefHeight="80"
                        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #673C70 0%, #C473D6 100%); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10;"/>

                <Button fx:id="viewClassesButton"
                        text="View Classes"
                        onAction="#handleViewClasses"
                        prefWidth="200" prefHeight="80"
                        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #673C70 0%, #C473D6 100%); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10;"/>
            </HBox>

            <!-- Second Row of Buttons -->
            <HBox alignment="CENTER" spacing="30">
                <Button fx:id="workoutButton"
                        text="Workout"
                        onAction="#handleWorkout"
                        prefWidth="200" prefHeight="80"
                        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #673C70 0%, #C473D6 100%); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10;"/>

                <Button fx:id="gymMapButton"
                        text="Gym Map"
                        onAction="#handleGymMap"
                        prefWidth="200" prefHeight="80"
                        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #673C70 0%, #C473D6 100%); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10;"/>
            </HBox>
        </VBox>

        <!-- Motivational Text -->
        <Label text="Ready to get stronger, healthier, and more confident? Let's grind!!!"
               style="-fx-text-fill: #00772A; -fx-font-weight: bold; -fx-font-size: 18px;"
               wrapText="true" textAlignment="CENTER"
               prefWidth="500.0"/>

        <!-- Back Button -->
        <Button fx:id="backButton"
                text="Back"
                onAction="#handleBack"
                prefWidth="120" prefHeight="40"
                style="-fx-background-color: #00772A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
    </children>
</VBox>