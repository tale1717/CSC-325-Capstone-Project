<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="400.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.firebaseadminjavafx.GymAppHomeController">

    <HBox spacing="6" alignment="CENTER">
        <Label text="Email:"/>
        <Label fx:id="emailValue" text="(loading)"/>
    </HBox>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gym Home"/>

    <Button fx:id="gymLayoutButton" onAction="#handleGymLayout" prefWidth="180" text="Gym Layout"/>

    <Button fx:id="workoutPlanningButton" onAction="#handleWorkoutPlanning" prefWidth="180" text="Workout Planning"/>

    <Button fx:id="progressTrackerButton" onAction="#handleProgressTracker" prefWidth="180"
            text="Workout Progress Tracker"/>

    <Button fx:id="classSchedulerButton" onAction="#handleClassScheduling" prefWidth="180" text="Classes"/>

    <Button fx:id="myProfileButton" onAction="#handleMyProfile" prefWidth="180" text="My Profile"/>

    <Button fx:id="returnToWelcomeButton" onAction="#handleReturnToWelcome" prefWidth="180" text="Return to Welcome"/>
</VBox>
