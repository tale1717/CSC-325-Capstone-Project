<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.firebaseadminjavafx.GymAppHomeController"
           prefWidth="600.0" prefHeight="800.0"
           stylesheets="@welcome.css">

    <!-- Background Image -->
    <ImageView fitWidth="600" fitHeight="800" preserveRatio="false">
        <image>
            <Image url="@GymAppHome.png" />
        </image>
    </ImageView>

    <!-- Content Container -->
    <VBox alignment="TOP_CENTER" spacing="30.0" style="-fx-padding: 40;">
        <!-- Title -->
        <Label text="Gym Prototype" style="-fx-text-fill: #FFD700; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 5, 0, 0, 2);">
            <font>
                <Font size="32.0" />
            </font>
        </Label>

        <!-- Main Button Grid -->
        <VBox alignment="CENTER" spacing="20">
            <!-- First Row of Buttons -->
            <HBox alignment="CENTER" spacing="30">
                <Button fx:id="profileButton"
                        text="Profile"
                        onAction="#handleProfile"
                        prefWidth="200" prefHeight="80"
                        style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 8, 0, 0, 3);"/>

                <Button fx:id="viewClassesButton"
                        text="View Classes"
                        onAction="#handleViewClasses"
                        prefWidth="200" prefHeight="80"
                        style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 8, 0, 0, 3);"/>
            </HBox>

            <!-- Second Row of Buttons -->
            <HBox alignment="CENTER" spacing="30">
                <Button fx:id="workoutButton"
                        text="Workout"
                        onAction="#handleWorkout"
                        prefWidth="200" prefHeight="80"
                        style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 8, 0, 0, 3);"/>

                <Button fx:id="gymMapButton"
                        text="Gym Map"
                        onAction="#handleGymMap"
                        prefWidth="200" prefHeight="80"
                        style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 8, 0, 0, 3);"/>
            </HBox>

            <!-- Third Row - Workout Progress Tracker -->
            <HBox alignment="CENTER" spacing="30">
                <Button fx:id="progressTrackerButton"
                        text="Workout Progress Tracker"
                        onAction="#handleProgressTracker"
                        prefWidth="430" prefHeight="80"
                        style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 8, 0, 0, 3);"/>
            </HBox>
        </VBox>

        <!-- Motivational Text -->
        <Label text="Ready to get stronger, healthier, and more confident? Let's grind!!!"
               style="-fx-text-fill: #FFD700; -fx-font-weight: bold; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 3, 0, 0, 1);"
               wrapText="true" textAlignment="CENTER"
               maxWidth="550.0" prefWidth="550.0"/>

        <!-- Back Button -->
        <Button fx:id="backButton"
                text="Back"
                onAction="#handleBack"
                prefWidth="120" prefHeight="40"
                style="-fx-background-color: #B71C1C; -fx-text-fill: #FFFAFA; -fx-font-weight: bold; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 5, 0, 0, 2);"/>
    </VBox>
</StackPane>